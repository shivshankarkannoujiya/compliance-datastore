{
  "name": "compliance-datastore",
  "version": "0.1.0",
  "private": true,
  "description": "Compliance data store: rules and scoring engine that replaces the Compliance Data.xlsm calculations",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --selectProjects unit",
    "test:cov": "jest --selectProjects unit --coverage",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm run lint:arch && npm test",
    "test:int": "jest --selectProjects integration --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "dependency-cruiser": "16.10.4",
    "jest": "29.7.0",
    "prisma": "^6.19.3",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
